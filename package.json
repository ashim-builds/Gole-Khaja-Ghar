{
  "name": "golu-khaja-ghar-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "services"
  ],
  "scripts": {
    "dev": "concurrently -n \"services,web\" -c \"blue,green\" \"npm run dev:services\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:services": "npm run dev --workspace=services",
    "build:web": "npm run build --workspace=web",
    "build:services": "npm run build --workspace=services",
    "build": "npm run build:services && npm run build:web"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "concurrently": "^10.0.5",
    "prisma": "^6.4.1"
  }
}
