# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/rjflower/api-golekhajaghar.com"
PassengerBaseURI "/"
PassengerNodejs "/home/rjflower/nodevenv/api-golekhajaghar.com/20/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerAppLogFile "/home/rjflower/api-golekhajaghar.com/stderr.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# ==============================================================================
# CloudLinux LVE & Phusion Passenger Process Optimization
# Caps idle/peak process count to <15 and prevents 508 Resource Limit Errors
# ==============================================================================
PassengerMaxPoolSize 2
PassengerMinInstances 1
PassengerPoolIdleTime 300
PassengerStatThrottleRate 60

# Prevent directory listings
Options -Indexes

# Block direct browser access to environment variables, configs, and sensitive files
<FilesMatch "^(\.env|\.env\..*|\.git.*|package\.json|package-lock\.json|tsconfig\.json|.*\.sql|.*\.log|Dockerfile)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden dotfiles & dotdirs (e.g. .git, .env)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.(?!well-known/) - [F,L]
</IfModule>
