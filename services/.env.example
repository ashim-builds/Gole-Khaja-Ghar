# Database Configuration (MySQL 8.0)
# On cPanel/CloudLinux shared environments, append ?connection_limit=5&pool_timeout=10 to prevent connection pool exhaustion
DATABASE_URL="mysql://golu_user:golu_pass_123@localhost:3306/golu_khaja_ghar?connection_limit=5&pool_timeout=10"

# Server Configuration
PORT=4000
NODE_ENV=development
TOKIO_WORKER_THREADS=1
UV_THREADPOOL_SIZE=2

# Authentication & Security Secrets
JWT_SECRET=your_secure_jwt_secret_key_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (VAPID) Credentials
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@golekhajaghar.com

# --- SMTP Email Configuration (for OTP Account Verification) ---
# Option 1: Gmail SMTP (Use 16-character Google App Password with 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Gole Khaja Ghar <your_email@gmail.com>"

# Option 2: cPanel Shared Hosting Webmail (Exim)
# SMTP_HOST=mail.golekhajaghar.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@golekhajaghar.com
